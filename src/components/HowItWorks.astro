---
import { howItWorks } from '../data/content';
import Icon from './Icon.astro';
import MissionMap from './MissionMap.astro';
---

<section class="section" id="how">
  <div class="container">
    <header class="head">
      <span class="eyebrow reveal">01 — What it does &amp; how it works</span>
      <h2 class="section-title reveal">From orbital data to a <span class="gradient-text">safe path</span> on Mars.</h2>
      <p class="section-lead reveal">{howItWorks.intro}</p>
    </header>

    <ol class="steps">
      {
        howItWorks.steps.map((step, i) => (
          <li class="card reveal" style={`--delay: ${i * 100}ms`}>
            <div class="step-top">
              <div class="icon-badge">
                <Icon name={step.icon} />
              </div>
              <span class="num">0{i + 1}</span>
            </div>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </li>
        ))
      }
    </ol>

    <MissionMap />
  </div>
</section>

<style>
  .steps {
    list-style: none;
    margin: 3.5rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
    counter-reset: step;
  }

  .steps li {
    position: relative;
  }

  .steps li:not(:last-child)::after {
    content: '';
    position: absolute;
    top: 52px;
    right: -1.25rem;
    width: 1.25rem;
    height: 1px;
    background: linear-gradient(90deg, var(--mars), transparent);
  }

  .step-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .num {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--muted);
  }

  h3 {
    margin-top: 1.5rem;
    font-size: 1.2rem;
  }

  p {
    margin-top: 0.6rem;
    color: var(--muted);
    font-size: 0.95rem;
  }

  @media (max-width: 1000px) {
    .steps {
      grid-template-columns: repeat(2, 1fr);
    }
    .steps li::after {
      display: none;
    }
  }

  @media (max-width: 600px) {
    .steps {
      grid-template-columns: 1fr;
    }
  }
</style>
