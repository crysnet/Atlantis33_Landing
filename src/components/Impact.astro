---
import { impact } from '../data/content';
import Icon from './Icon.astro';
---

<section class="section impact" id="impact">
  <div class="horizon" aria-hidden="true"></div>
  <div class="container">
    <div class="intro">
      <div>
        <span class="eyebrow reveal">03 — Intended impact</span>
        <h2 class="section-title reveal">One small route, <span class="gradient-text">one giant leap.</span></h2>
      </div>
      <p class="section-lead reveal">{impact.intro}</p>
    </div>

    <dl class="stats">
      {
        impact.stats.map((s, i) => (
          <div class="reveal" style={`--delay: ${i * 100}ms`}>
            <dt>{s.label}</dt>
            <dd>
              <span class="counter" data-target={s.value}>0</span>
              <span class="suffix">{s.suffix}</span>
            </dd>
          </div>
        ))
      }
    </dl>

    <div class="audiences">
      {
        impact.audiences.map((a, i) => (
          <article class="card reveal" style={`--delay: ${i * 100}ms`}>
            <div class="icon-badge">
              <Icon name={a.icon} />
            </div>
            <div>
              <h3>{a.title}</h3>
              <p>{a.text}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .impact {
    overflow: hidden;
  }

  .horizon {
    position: absolute;
    left: 50%;
    top: 55%;
    width: 1800px;
    height: 1800px;
    transform: translateX(-50%);
    border-radius: 50%;
    background: radial-gradient(circle at 50% 0%, rgba(226, 88, 62, 0.25), rgba(120, 30, 15, 0.08) 30%, transparent 55%);
    border-top: 1px solid rgba(255, 138, 91, 0.35);
    box-shadow: 0 -30px 120px -20px rgba(226, 88, 62, 0.45);
    pointer-events: none;
    z-index: -1;
  }

  .intro {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    align-items: end;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin: 4rem 0 0;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .stats div {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    padding: 2rem 1.5rem;
  }

  .stats div + div {
    border-left: 1px solid var(--border);
  }

  .stats dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 5vw, 3.8rem);
    font-weight: 700;
    line-height: 1;
  }

  .suffix {
    color: var(--mars-light);
  }

  .stats dt {
    margin-top: 0.6rem;
    color: var(--muted);
  }

  .audiences {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
    margin-top: 3rem;
  }

  .audiences article {
    display: flex;
    gap: 1.1rem;
    align-items: flex-start;
  }

  .audiences .icon-badge {
    flex-shrink: 0;
  }

  h3 {
    font-size: 1.1rem;
  }

  .audiences p {
    margin-top: 0.4rem;
    color: var(--muted);
    font-size: 0.95rem;
  }

  @media (max-width: 900px) {
    .intro,
    .audiences {
      grid-template-columns: 1fr;
    }
    .stats {
      grid-template-columns: repeat(2, 1fr);
    }
    .stats div:nth-child(3) {
      border-left: 0;
    }
    .stats div:nth-child(n + 3) {
      border-top: 1px solid var(--border);
    }
  }
</style>

<script>
  const counters = document.querySelectorAll<HTMLElement>('.counter');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const animate = (el: HTMLElement) => {
    const target = Number(el.dataset.target);
    if (reduceMotion) {
      el.textContent = String(target);
      return;
    }
    const start = performance.now();
    const duration = 1600;
    const tick = (now: number) => {
      const p = Math.min((now - start) / duration, 1);
      const eased = 1 - Math.pow(1 - p, 3);
      el.textContent = String(Math.round(target * eased));
      if (p < 1) requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  };

  const io = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) {
          animate(entry.target as HTMLElement);
          io.unobserve(entry.target);
        }
      }
    },
    { threshold: 0.6 },
  );

  counters.forEach((c) => io.observe(c));
</script>
