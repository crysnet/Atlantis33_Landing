---
import { missionMap } from '../data/content';

const { routes, bases } = missionMap;
const initial = routes[0];
---

<div class="mission card reveal" id="mission-map">
  <div class="map-wrap">
    <div class="map-hud">
      <span>SINUS MERIDIANI · TRAVERSE PLANNER</span>
      <span>SECTOR JZ-07 · 10 m/px</span>
    </div>

    <svg class="map" viewBox="0 -30 800 530" role="img" aria-label="Interactive map of planned routes between Mars bases">
      <defs>
        <linearGradient id="terrain" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#5a2216"></stop>
          <stop offset="0.5" stop-color="#7a3020"></stop>
          <stop offset="1" stop-color="#3e170e"></stop>
        </linearGradient>
        <filter id="terrainNoise" x="0" y="0" width="100%" height="100%">
          <feTurbulence type="fractalNoise" baseFrequency="0.012 0.02" numOctaves="5" seed="3"></feTurbulence>
          <feColorMatrix type="matrix" values="0 0 0 0 0.95  0 0 0 0 0.6  0 0 0 0 0.4  1.6 0 0 0 -0.65"></feColorMatrix>
        </filter>
        <radialGradient id="mapCrater" cx="45%" cy="45%" r="55%">
          <stop offset="0" stop-color="#1e0904" stop-opacity="0.75"></stop>
          <stop offset="0.85" stop-color="#2a0d06" stop-opacity="0.4"></stop>
          <stop offset="1" stop-color="#ffb37a" stop-opacity="0.35"></stop>
        </radialGradient>
        <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
          <path d="M40 0H0V40" fill="none" stroke="#fff" stroke-opacity="0.06"></path>
        </pattern>
        <filter id="glow" x="-20%" y="-20%" width="140%" height="140%">
          <feGaussianBlur stdDeviation="4" result="b"></feGaussianBlur>
          <feMerge><feMergeNode in="b"></feMergeNode><feMergeNode in="SourceGraphic"></feMergeNode></feMerge>
        </filter>
      </defs>

      <rect y="-30" width="800" height="530" fill="url(#terrain)"></rect>
      <rect y="-30" width="800" height="530" filter="url(#terrainNoise)" opacity="0.35"></rect>

      <!-- Contour lines -->
      <g fill="none" stroke="#ffcfa8" stroke-opacity="0.12">
        <path d="M0 90 C 120 60, 220 130, 360 95 S 600 40, 800 80"></path>
        <path d="M0 140 C 140 110, 240 180, 380 150 S 620 90, 800 130"></path>
        <path d="M0 470 C 150 440, 300 490, 450 455 S 700 430, 800 460"></path>
        <path d="M110 -30 C 160 80, 120 160, 190 230 S 160 380, 230 500"></path>
        <ellipse cx="540" cy="200" rx="120" ry="60"></ellipse>
        <ellipse cx="540" cy="200" rx="80" ry="36"></ellipse>
      </g>

      <rect y="-30" width="800" height="530" fill="url(#grid)"></rect>

      <!-- Hazards -->
      <g class="hazards">
        <circle cx="300" cy="195" r="48" fill="url(#mapCrater)"></circle>
        <circle cx="180" cy="245" r="24" fill="url(#mapCrater)"></circle>
        <circle cx="560" cy="430" r="34" fill="url(#mapCrater)"></circle>
        <circle cx="660" cy="250" r="28" fill="url(#mapCrater)"></circle>
        <ellipse cx="390" cy="95" rx="95" ry="45" fill="#ffb86b" fill-opacity="0.08" stroke="#ffb86b" stroke-opacity="0.6" stroke-dasharray="5 5"></ellipse>
        <text x="390" y="99" text-anchor="middle" class="hz-label">DUST HAZARD</text>
        <text x="300" y="258" text-anchor="middle" class="hz-label">STEEP CRATER</text>
      </g>

      <!-- Routes -->
      <g class="routes">
        {
          routes.map((r) => (
            <g class:list={['route', { active: r.id === initial.id }]} data-route={r.id}>
              <path class="route-base" d={r.path} />
              <path class="route-flow" d={r.path} filter="url(#glow)" />
            </g>
          ))
        }
      </g>

      <!-- Habitat -->
      <g transform="translate(90 400)">
        <circle r="18" fill="#f1ebe6" fill-opacity="0.12" stroke="#f1ebe6" stroke-opacity="0.5"></circle>
        <path d="M-9 6 V0 A9 9 0 0 1 9 0 V6 Z" fill="#f1ebe6"></path>
        <rect x="-2.5" y="1" width="5" height="5" rx="1" fill="#3e170e"></rect>
        <path d="M-12 6 H12" stroke="#f1ebe6" stroke-width="1.5" stroke-linecap="round"></path>
        <text x="0" y="38" text-anchor="middle" class="label">HABITAT</text>
        <title>Habitat: mission starting point</title>
      </g>

      <!-- Bases -->
      {
        bases.map((b) => (
          <g class="base" transform={`translate(${b.x} ${b.y})`}>
            <circle class="base-ring" r="18" fill="none" stroke={b.color} />
            <rect x="-7" y="-7" width="14" height="14" transform="rotate(45)" fill={b.color} />
            <text x="0" y="-26" text-anchor="middle" class="label">{b.name.toUpperCase()}</text>
            <text x="0" y="36" text-anchor="middle" class="sub" fill={b.color}>{b.find}</text>
            <title>{`${b.name}: ${b.find}`}</title>
          </g>
        ))
      }

      <!-- Compass -->
      <g transform="translate(752 60)" class="compass">
        <circle r="22" fill="rgba(7,6,11,.5)" stroke="#fff" stroke-opacity="0.2"></circle>
        <path d="M0 -15 L5 0 L0 -3 L-5 0Z" fill="#ff8a5b"></path>
        <text y="-28" text-anchor="middle" class="label">N</text>
      </g>
    </svg>
  </div>

  <aside class="panel">
    <span class="eyebrow">Live demo</span>
    <h3>Choose a target waypoint</h3>
    <p class="hint">Select destination waypoints enriched in aqueous alteration minerals and paleohydrological features to maximize biosignature preservation potential.</p>

    <div class="tabs" role="tablist" aria-label="Destination base">
      {
        routes.map((r) => (
          <button
            type="button"
            role="tab"
            aria-selected={r.id === initial.id ? 'true' : 'false'}
            data-route={r.id}
            data-distance={r.distance}
            data-duration={r.duration}
          >
            {r.label}
          </button>
        ))
      }
    </div>

    <dl class="metrics">
      <div><dt>Distance</dt><dd data-metric="distance">{initial.distance}</dd></div>
      <div><dt>EVA time</dt><dd data-metric="duration">{initial.duration}</dd></div>
    </dl>
  </aside>
</div>

<style>
  .mission {
    margin-top: 3rem;
    display: grid;
    grid-template-columns: 1.7fr 1fr;
    gap: 0;
    padding: 0;
    overflow: hidden;
  }

  .mission:hover {
    transform: none;
  }

  .map-wrap {
    position: relative;
    border-right: 1px solid var(--border);
  }

  .map {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .map-hud {
    position: absolute;
    inset: 0 0 auto 0;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 0.8rem 1rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    color: rgba(255, 255, 255, 0.65);
    background: linear-gradient(180deg, rgba(7, 6, 11, 0.6), transparent);
    pointer-events: none;
  }

  .map-hud span:last-child {
    text-align: right;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .label {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    fill: #f1ebe6;
  }

  .sub {
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 600;
  }

  .hz-label {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.15em;
    fill: #ffcfa8;
    opacity: 0.7;
  }

  .route path {
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition:
      opacity 0.4s,
      stroke 0.4s;
  }

  .route-base {
    stroke: #fff;
    stroke-width: 2;
    stroke-opacity: 0.18;
    stroke-dasharray: 2 6;
  }

  .route-flow {
    stroke: #ffe3c8;
    stroke-width: 3.5;
    stroke-dasharray: 10 10;
    opacity: 0;
  }

  .route.active .route-base {
    stroke-opacity: 0;
  }

  .route.active .route-flow {
    opacity: 1;
    animation: flow 1.2s linear infinite;
  }

  @keyframes flow {
    to {
      stroke-dashoffset: -40;
    }
  }

  .base-ring {
    stroke-width: 1.5;
    transform-box: fill-box;
    transform-origin: center;
    animation: ring 2.6s ease-out infinite;
  }

  @keyframes ring {
    0% {
      transform: scale(0.6);
      opacity: 1;
    }
    100% {
      transform: scale(1.8);
      opacity: 0;
    }
  }

  .panel {
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .panel h3 {
    font-size: 1.5rem;
  }

  .hint {
    color: var(--muted);
    font-size: 0.92rem;
  }

  .tabs {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.35rem;
    padding: 0.35rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.25);
    margin-top: 0.5rem;
  }

  .tabs button {
    font: inherit;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--muted);
    background: none;
    border: 0;
    border-radius: 999px;
    padding: 0.6rem 0.4rem;
    cursor: pointer;
    transition:
      background 0.25s,
      color 0.25s;
  }

  .tabs button:hover {
    color: var(--text);
  }

  .tabs button[aria-selected='true'] {
    background: linear-gradient(120deg, var(--mars-light), var(--mars));
    color: #1a0905;
  }

  .metrics {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
    margin: 0.5rem 0 0;
  }

  .metrics div {
    padding: 0.9rem 1rem;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.02);
  }

  .metrics dt {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .metrics dd {
    margin: 0.2rem 0 0;
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 600;
  }

  @media (max-width: 1000px) {
    .mission {
      grid-template-columns: 1fr;
    }
    .map-wrap {
      border-right: 0;
      border-bottom: 1px solid var(--border);
    }
  }

  @media (max-width: 640px) {
    .map-hud {
      padding: 0.5rem 0.7rem;
      font-size: 0.52rem;
      letter-spacing: 0.06em;
      gap: 0.5rem;
    }
  }
</style>

<script>
  const root = document.getElementById('mission-map')!;
  const buttons = root.querySelectorAll<HTMLButtonElement>('.tabs button');
  const routes = root.querySelectorAll<SVGGElement>('.route');

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const id = btn.dataset.route;
      buttons.forEach((b) => b.setAttribute('aria-selected', String(b === btn)));
      routes.forEach((r) => r.classList.toggle('active', r.dataset.route === id));
      for (const key of ['distance', 'duration']) {
        const el = root.querySelector<HTMLElement>(`[data-metric="${key}"]`);
        if (el) el.textContent = btn.dataset[key] ?? '';
      }
    });
  });
</script>
