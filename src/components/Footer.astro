---
import { site, teamMembers } from '../data/content';
import Icon from './Icon.astro';

const initials = (name: string) =>
  name
    .split(' ')
    .map((n) => n[0])
    .join('')
    .slice(0, 2);
---

<section class="section cta" id="team">
  <div class="container">
    <div class="panel reveal">
      <span class="eyebrow">Team {site.team}</span>
      <h2>Ready for launch.<br /><span class="gradient-text">Next stop: Mars.</span></h2>
      <p>
        We are {site.team}, a multidisciplinary team building tools for the next generation of planetary explorers.
      </p>

      <ul class="team">
        {
          teamMembers.map((m) => (
            <li>
              <span class="avatar">{initials(m.name)}</span>
              <span>
                <strong>{m.name}</strong>
                <small>{m.role}</small>
              </span>
            </li>
          ))
        }
      </ul>

      <div class="actions">
        <a href="#mission-map" class="btn btn-primary">
          Explore the demo
          <Icon name="arrow" size={18} />
        </a>
        <a href="#top" class="btn btn-ghost">Back to top</a>
      </div>
    </div>
  </div>
</section>

<footer class="footer">
  <div class="container footer-inner">
    <p>© {new Date().getFullYear()} {site.team} · {site.product}</p>
    <p class="note">Concept project for the {site.event}. Not affiliated with or endorsed by NASA.</p>
  </div>
</footer>

<style>
  .panel {
    position: relative;
    text-align: center;
    padding: clamp(3rem, 7vw, 5rem) clamp(1.5rem, 5vw, 4rem);
    border: 1px solid var(--border-strong);
    border-radius: 28px;
    background:
      radial-gradient(ellipse 70% 60% at 50% 120%, rgba(226, 88, 62, 0.35), transparent 70%),
      linear-gradient(180deg, rgba(255, 255, 255, 0.04), rgba(255, 255, 255, 0.01));
    overflow: hidden;
  }

  .panel .eyebrow::before {
    display: none;
  }

  h2 {
    margin-top: 1rem;
    font-size: clamp(2.2rem, 5vw, 3.8rem);
  }

  .panel > p {
    margin: 1.25rem auto 0;
    color: var(--muted);
    max-width: 52ch;
  }

  .team {
    list-style: none;
    padding: 0;
    margin: 2.5rem 0 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
  }

  .team li {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.5rem 1rem 0.5rem 0.5rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: rgba(7, 6, 11, 0.5);
    text-align: left;
  }

  .avatar {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    font-family: var(--font-display);
    font-size: 0.85rem;
    font-weight: 600;
    color: #1a0905;
    background: linear-gradient(135deg, var(--dust), var(--mars));
  }

  .team strong {
    display: block;
    font-size: 0.9rem;
    line-height: 1.2;
  }

  .team small {
    color: var(--muted);
    font-size: 0.78rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
    margin-top: 2.5rem;
  }

  .footer {
    border-top: 1px solid var(--border);
    padding: 2rem 0;
    font-size: 0.85rem;
    color: var(--muted);
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
  }

  .note {
    opacity: 0.7;
  }
</style>
